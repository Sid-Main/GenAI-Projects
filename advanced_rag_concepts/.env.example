# Template for .env — copy it, fill in real values. Never commit .env itself.

# ── Postgres (read by docker compose) ──
POSTGRES_USER=rag              # Database username
POSTGRES_PASSWORD=change-me    # Database password: set a real one in .env
POSTGRES_DB=rag                # Database name
POSTGRES_PORT=5433             # Host port for Postgres (5432 is used by your Windows Postgres)

# ── Ollama (read by docker compose) ──
OLLAMA_PORT=11434              # Host port for the Ollama API

# ── Backend (read by FastAPI settings) ──
DATABASE_URL=postgresql+asyncpg://rag:change-me@localhost:5433/rag   # driver://user:password@host:port/db — must match the values above
OLLAMA_BASE_URL=http://localhost:11434   # Where the backend reaches Ollama
OLLAMA_CHAT_MODEL=llama3.2:1b            # Model used to generate answers
OLLAMA_EMBED_MODEL=nomic-embed-text      # Model used to create embeddings